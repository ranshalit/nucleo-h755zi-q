#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

&gpiod {
	usb_vbus_disable {
		gpio-hog;
		gpios = <10 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "USB VBUS disable (active-low enable)";
	};
};

/* MCU internal die temperature sensor (ADC3 channel 18, factory calibrated). */
&adc3 {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
};

&die_temp {
	status = "okay";
};

/*
 * The CM4 is unused. M7 owns both 1 MiB flash banks; bank 2 sector 0 extends
 * the image and sector 1 holds the read-only speech models. Keep BCM4=0 and
 * CONFIG_STM32H7_BOOT_M4_AT_INIT=n.
 */
&flash0 {
	reg = <0x08000000 DT_SIZE_M(2)>;
};

/ {
	speech_model_flash: memory@8120000 {
		compatible = "zephyr,memory-region";
		reg = <0x08120000 DT_SIZE_K(128)>;
		zephyr,memory-region = "SPEECH_BANK2";
	};
};

/* Ethernet DMA descriptors/buffers live here; keep them coherent with D-cache on. */
&sram3 {
	zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
};

/* CPU-only speech arenas use DTCM; no peripheral DMA buffers belong here. */
&dtcm {
	zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM)>;
};
