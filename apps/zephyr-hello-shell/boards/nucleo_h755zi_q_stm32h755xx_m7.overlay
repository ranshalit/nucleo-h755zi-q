&gpiod {
	usb_vbus_disable {
		gpio-hog;
		gpios = <10 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "USB VBUS disable (active-low enable)";
	};
};

/* MCU internal die temperature sensor (ADC3 channel 18, factory calibrated). */
&adc3 {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
};

&die_temp {
	status = "okay";
};

/*
 * Flash bank 2 sector 0 (normally the CM4 image) holds the read-only speech
 * models. The CM4 is unused: keep BCM4=0 and CONFIG_STM32H7_BOOT_M4_AT_INIT=n.
 */
/ {
	speech_model_flash: memory@8100000 {
		compatible = "zephyr,memory-region";
		reg = <0x08100000 DT_SIZE_K(128)>;
		zephyr,memory-region = "SPEECH_BANK2";
	};
};
