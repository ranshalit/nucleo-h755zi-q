 *
 * In-RAM disk backing store for the USB mass storage demo, plus the
 * Ethernet PHY tweak needed by board_http_server_start().
 */

&eth_phy {
	no-reset;
};

/ {
	ramdisk0 {
		compatible = "zephyr,ram-disk";
		disk-name = "RAM";
		sector-size = <512>;
		sector-count = <256>;
	};
};
